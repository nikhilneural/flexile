# Redis
REDIS_URL="redis://localhost:6379/0"
SIDEKIQ_REDIS_URL="redis://localhost:6379/1"

# Wise
WISE_API_KEY="mock_wise_api_key_demo"
WISE_PROFILE_ID="mock_wise_profile_id_demo"
