# ==============================================================
# Next.js Complete Standalone Demo Environment
# Brand: fillanadpay
# Copy this to .env.local and apps/next/.env.local:
#   cp env.demo.example .env.local
#   cp env.demo.example apps/next/.env.local
# ==============================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flexile_development"

# App & Environment
EMAIL_DOMAIN="fillanadpay.com"
VERCEL_ENV="development"
DEFAULT_DEMO_COMPANY_ID="1"

# Encryption Keys (32-byte base64 encoded for AES-256-GCM)
ACTIVERECORD_DETERMINISTIC_DERIVED_KEY="ZdTfFS+b5g0Su/PnPCoF3oBcrgozB4jOwaRl+Zb9YhA="
ACTIVERECORD_DERIVED_KEY="ZdTfFS+b5g0Su/PnPCoF3oBcrgozB4jOwaRl+Zb9YhA="

# AWS & S3 Storage
AWS_ACCESS_KEY_ID="demo_aws_access_key"
AWS_SECRET_ACCESS_KEY="demo_aws_secret_key"
AWS_REGION="us-east-1"
S3_PRIVATE_BUCKET="fillanadpay-private-bucket"
S3_PUBLIC_BUCKET="fillanadpay-public-bucket"

# Clerk Authentication (Native Next.js auth)
CLERK_SECRET_KEY="sk_test_demo123456789demo123456789demo123456"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk"

# Stripe
STRIPE_SECRET_KEY="sk_test_mock_stripe_secret_key_demo"
STRIPE_ENDPOINT_SECRET="whsec_mock_stripe_endpoint_secret_demo"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_stripe_publishable_key_demo"

# Resend / Email
RESEND_API_KEY="re_mock_resend_api_key_demo"

# Google Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="demo-google-oauth-client-id.apps.googleusercontent.com"

# DocuSeal E-signatures
DOCUSEAL_TOKEN="mock_docuseal_token_demo"
DOCUSEAL_USER_EMAIL="admin@fillanadpay.com"
NEXT_PUBLIC_EQUITY_EXERCISE_DOCUSEAL_ID="mock_equity_exercise_template_id"

# GitHub Integration
GH_CLIENT_ID="demo_github_client_id"
GH_CLIENT_SECRET="demo_github_client_secret"
GH_WEBHOOK_SECRET="demo_github_webhook_secret"
GITHUB_WEBHOOK_SECRET="demo_github_webhook_secret"

# QuickBooks Integration
QUICKBOOKS_CLIENT_ID="demo_quickbooks_client_id"
