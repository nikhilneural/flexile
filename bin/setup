#!/bin/bash

# Exit on error
set -e

echo "🚀 Setting up FillanadPay Next.js development environment..."

corepack enable
pnpm install

if [ ! -f ".env.local" ]; then
  if [ -f "env.demo.example" ]; then
    echo "Creating .env.local from demo template..."
    cp env.demo.example .env.local
    cp env.demo.example apps/next/.env.local
  fi
fi

echo "✨ Setup complete! You can now start the development server with: pnpm dev"
