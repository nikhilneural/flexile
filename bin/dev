#!/usr/bin/env bash

# Setup environment if missing
if [ ! -f ".env.local" ] && [ ! -f "apps/next/.env.local" ]; then
  if [ -f "env.demo.example" ]; then
    echo "Creating .env.local from demo template..."
    cp env.demo.example .env.local
    cp env.demo.example apps/next/.env.local
  fi
fi

exec pnpm next dev apps/next -p 3000 "$@"
