#!/bin/bash

set -e

cd "$(dirname "$0")/.."

function kill_process_listening_on_port {
  lsof -i :$1 | grep LISTEN | awk '{print $2}' | xargs -r kill -9 2>/dev/null || true
}

echo "Starting application services"
kill_process_listening_on_port 3100
kill_process_listening_on_port 3000

export NODE_ENV=test

pnpm next dev apps/next -p 3100
